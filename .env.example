# SQLite local. La ruta es relativa a la raíz del proyecto.
DATABASE_URL="file:./prisma/dev.db"

# Secreto para firmar la cookie de sesión y hashear los códigos de verificación.
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Envío del código de confirmación de cuenta.
# Elegí UNO de los dos proveedores (los dos son gratis para empezar):
#
# Resend (necesita un remitente verificado):
#   RESEND_API_KEY="re_..."
#   EMAIL_FROM="Plata <no-reply@tudominio.com>"
#
# Brevo (permite verificar un solo correo, sin dominio propio):
#   BREVO_API_KEY="xkeysib-..."
#   EMAIL_FROM="Plata <tu-correo-verificado@gmail.com>"
#
# Sin ninguna de las dos, en desarrollo el código se imprime en la consola del
# server y se muestra en la pantalla de registro.
# EMAIL_FROM="Plata <no-reply@tudominio.com>"
