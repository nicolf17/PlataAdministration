// Modelo de dominio de Plata.
//
// Regla de oro: la plata se guarda en unidades menores enteras (Int), nunca en float.
// Para COP la unidad menor es el peso (decimales = 0), así que 1.800.000 se guarda como 1800000.
//
// Regla de oro 2: una cuenta (efectivo/banco) NO es lo mismo que una tarjeta de crédito.
// Un gasto con tarjeta es deuda, no salida de efectivo. Por eso `accountId` y `creditCardId`
// son campos distintos y una transacción puede tener uno, el otro, o ambos (pago de tarjeta).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  // Se completa cuando la persona confirma el código que le llega por correo.
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())

  accounts        Account[]
  creditCards     CreditCard[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  sessions       Session[]
}

model Session {
  id     String   @id @default(cuid())
  sid    String   @unique
  userId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Registro pendiente: existe solo entre "pedí el código" y "confirmé el código".
// La contraseña ya viene hasheada: nunca se guarda en claro ni en memoria de sesión.
model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

// Métricas reales de performance (LCP/INP/CLS) reportadas por el navegador.
model WebVital {
  id        String   @id @default(cuid())
  name      String
  value     Float
  rating    String?
  path      String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model Account {
  id                  String        @id @default(cuid())
  userId              String?
  name                String
  type                AccountType
  initialBalanceMinor Int           @default(0)
  archived            Boolean       @default(false)
  createdAt           DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[] @relation("AccountSource")
  transfersIn   Transaction[] @relation("AccountDestination")

  @@index([userId, archived])
}

model CreditCard {
  id         String    @id @default(cuid())
  userId     String?
  name       String
  limitMinor Int
  closingDay Int
  dueDay     Int
  archived   Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([userId, archived])
}

model Category {
  id       String       @id @default(cuid())
  userId   String?
  name     String
  type     CategoryType
  color    String       @default("#64748b")
  icon     String?
  parentId String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type, parentId])
  @@index([userId, type])
  @@index([parentId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String?
  date        DateTime
  type        TransactionType
  amountMinor Int
  description String
  notes       String?

  // Cuenta de origen (EXPENSE/TRANSFER) o destino (INCOME).
  accountId String?
  // Cuenta destino en una transferencia entre cuentas propias.
  transferAccountId String?
  // Tarjeta involucrada: compra con tarjeta (EXPENSE) o pago de tarjeta (TRANSFER).
  creditCardId String?
  categoryId   String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  account         Account?    @relation("AccountSource", fields: [accountId], references: [id], onDelete: Restrict)
  transferAccount Account?    @relation("AccountDestination", fields: [transferAccountId], references: [id], onDelete: Restrict)
  creditCard      CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: Restrict)
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
  @@index([accountId])
  @@index([creditCardId])
}

model Budget {
  id         String @id @default(cuid())
  userId     String?
  categoryId String
  month      String // "YYYY-MM"
  limitMinor Int

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([month])
}
